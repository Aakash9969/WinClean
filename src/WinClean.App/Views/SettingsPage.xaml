<UserControl x:Class="WinClean.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Left"
                    Margin="0,0,16,0">

            <!-- Theme -->
            <TextBlock Text="Theme"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Dark is the default. The switch applies immediately and is remembered."
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dark"
                                Command="{Binding UseDarkThemeCommand}"
                                MinWidth="90">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Light"
                                Command="{Binding UseLightThemeCommand}"
                                MinWidth="90"
                                Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <TextBlock Text="Rules enabled by default"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Disabled rules are skipped entirely: they are neither scanned nor shown in the review. Changes apply to the next scan."
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="6,4,6,10"
                               TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,6" ToolTip="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RuleName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="10,0,10,0"/>
                                    <Border Grid.Column="2" Style="{StaticResource RiskBadge}">
                                        <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <Border Grid.Column="3"
                                            Style="{StaticResource AdminBadge}"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Admin" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Category}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Footer note -->
            <TextBlock Text="Settings are stored in %LOCALAPPDATA%\WinClean\settings.json and clean history in %LOCALAPPDATA%\WinClean\history.json."
                       FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
