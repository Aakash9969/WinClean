<Window x:Class="WinClean.App.Views.ElevationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrator rights recommended"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BaseBackground}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <DockPanel Margin="24,20,24,20">
        <!-- Heading -->
        <StackPanel DockPanel.Dock="Top">
            <Path Data="M12 2 L20.5 5.2 L20.5 11 C20.5 16.4 16.9 20.5 12 22 C7.1 20.5 3.5 16.4 3.5 11 L3.5 5.2 Z"
                  Fill="{DynamicResource RiskModerateBrush}"
                  Width="30" Height="30"
                  Stretch="Uniform"
                  HorizontalAlignment="Left"/>
            <TextBlock Text="Some rules need administrator rights"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,12,0,6"/>
            <TextBlock Text="{Binding BodyText}"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="100"/>
            <Button Content="Continue without"
                    Command="{Binding ContinueWithoutCommand}"
                    MinWidth="120"
                    Margin="12,0,0,0"/>
            <Button Content="Restart elevated"
                    Command="{Binding ElevateCommand}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="130"
                    Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Rule list -->
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="10"
                Padding="12"
                Margin="0,14,0,0">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AdminRuleNames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="13"
                                       Margin="0,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
