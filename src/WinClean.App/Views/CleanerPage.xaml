<UserControl x:Class="WinClean.App.Views.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinClean.App.ViewModels"
             xmlns:conv="clr-namespace:WinClean.App.Converters">
    <UserControl.Resources>
        <conv:BytesToDisplayConverter x:Key="BytesToDisplay"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Cleaner"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ScanStatusText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       MaxWidth="520"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ScanStatusText}"/>
        </Grid>

        <!-- Rule loading errors -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasLoadErrors, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource RiskAdvancedBackground}"
                BorderBrush="{StaticResource RiskAdvancedBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,14">
            <TextBlock Text="{Binding LoadErrorText}"
                       Foreground="{StaticResource RiskAdvancedBrush}"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </Border>

        <Grid>
            <!-- IDLE -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Idle">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="M12 0.8 L14.5 9.5 L23.2 12 L14.5 14.5 L12 23.2 L9.5 14.5 L0.8 12 L9.5 9.5 Z"
                      Fill="{StaticResource AccentBrush}"
                      Width="44" Height="44"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,18"/>
                <TextBlock Text="Scan before you clean"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="WinClean scans every rule and shows exactly what it found — sizes, file counts and risk levels. Scanning never deletes anything. Nothing is ever removed until you review the results and approve it."
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,26"/>
                <Button Content="Scan now"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="170"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- SCANNING -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Scanning">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Scanning your system…"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ScanProgressPercent}"
                             Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ScanStatusText}"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button Content="Cancel"
                        Command="{Binding CancelScanCommand}"
                        Width="110"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- REVIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Review">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Summary -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="10"
                        Padding="18,12"
                        Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="FOUND"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Text="{Binding TotalReclaimableBytes, Converter={StaticResource BytesToDisplay}}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,2,0,0"
                                       Text="{Binding TotalFilesFound, StringFormat='{}{0} files'}"/>
                        </StackPanel>
                        <Rectangle Width="1"
                                   Fill="{StaticResource BorderColor}"
                                   Margin="26,2"/>
                        <StackPanel>
                            <TextBlock Text="SELECTED"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding SelectedBytes, Converter={StaticResource BytesToDisplay}}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,2,0,0"
                                       Text="{Binding SelectedSummaryText}"/>
                        </StackPanel>
                        <Rectangle Width="1"
                                   Fill="{StaticResource BorderColor}"
                                   Margin="26,2"/>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    MaxWidth="280">
                            <TextBlock Text="Unchecked rules are left untouched."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Hover a rule for its description and any scan notes."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Review tree -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardBackground}"
                        CornerRadius="10"
                        Padding="8,6">
                    <TreeView ItemsSource="{Binding Categories}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CategoryViewModel}"
                                                      ItemsSource="{Binding Rules}">
                                <StackPanel Orientation="Horizontal" MinHeight="34">
                                    <CheckBox IsThreeState="True"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="10,0,12,0"/>
                                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0} files'}"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:RuleViewModel}">
                                <Grid Margin="2,0,0,0"
                                      MinHeight="32"
                                      ToolTip="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Rule.Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="10,0,10,0"/>
                                    <Border Grid.Column="2" Style="{StaticResource RiskBadge}">
                                        <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <Border Grid.Column="3"
                                            Style="{StaticResource AdminBadge}"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Admin" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding NoteCount, StringFormat='{}{0} notes'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Rescan"
                            Command="{Binding ScanCommand}"
                            MinWidth="110"/>
                    <Button Content="Clean selected…"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            ToolTip="The clean flow arrives in Stage 5. Scanning and review are read-only."
                            MinWidth="150"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
