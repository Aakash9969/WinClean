<UserControl x:Class="WinClean.App.Views.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinClean.App.ViewModels"
             xmlns:conv="clr-namespace:WinClean.App.Converters">
    <UserControl.Resources>
        <conv:BytesToDisplayConverter x:Key="BytesToDisplay"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Cleaner"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       MaxWidth="520"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}"/>
        </Grid>

        <!-- Rule loading errors -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasLoadErrors, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource RiskAdvancedBackground}"
                BorderBrush="{DynamicResource RiskAdvancedBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,14">
            <TextBlock Text="{Binding LoadErrorText}"
                       Foreground="{DynamicResource RiskAdvancedBrush}"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </Border>

        <Grid>
            <!-- IDLE -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Idle">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="M12 0.8 L14.5 9.5 L23.2 12 L14.5 14.5 L12 23.2 L9.5 14.5 L0.8 12 L9.5 9.5 Z"
                      Fill="{DynamicResource AccentBrush}"
                      Width="44" Height="44"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,18"/>
                <TextBlock Text="Scan before you clean"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="WinClean scans every enabled rule and shows exactly what it found — sizes, file counts and risk levels. Scanning never deletes anything. Nothing is ever removed until you review the results and confirm it in the clean dialog. Administrator rights are requested only when an enabled rule needs them."
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,26"/>
                <Button Content="Scan now"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="170"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- SCANNING -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Scanning">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Scanning your system…"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button Content="Cancel"
                        Command="{Binding CancelScanCommand}"
                        Width="110"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CLEANING -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Cleaning">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Cleaning…"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCleanSelectedCommand}"
                        Width="110"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- REVIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Review">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Summary -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="18,12"
                        Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="FOUND"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Text="{Binding TotalReclaimableBytes, Converter={StaticResource BytesToDisplay}}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,2,0,0"
                                       Text="{Binding TotalFilesFound, StringFormat='{}{0:#,0} files'}"/>
                        </StackPanel>
                        <Rectangle Width="1"
                                   Fill="{DynamicResource BorderColor}"
                                   Margin="26,2"/>
                        <StackPanel>
                            <TextBlock Text="SELECTED"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding SelectedBytes, Converter={StaticResource BytesToDisplay}}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,2,0,0"
                                       Text="{Binding SelectedSummaryText}"/>
                        </StackPanel>
                        <Rectangle Width="1"
                                   Fill="{DynamicResource BorderColor}"
                                   Margin="26,2"/>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    MaxWidth="280">
                            <TextBlock Text="Unchecked rules are left untouched."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Expand a rule to see the exact files it found; hover one for details and scan notes."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Review tree -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="8,6">
                    <TreeView ItemsSource="{Binding Categories}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CategoryViewModel}"
                                                      ItemsSource="{Binding Rules}">
                                <StackPanel Orientation="Horizontal" MinHeight="34">
                                    <CheckBox IsThreeState="True"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="10,0,12,0"/>
                                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0:#,0} files'}"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:RuleViewModel}"
                                                      ItemsSource="{Binding Details}">
                                <Grid Margin="2,0,0,0"
                                      MinHeight="32"
                                      ToolTip="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Rule.Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="10,0,10,0"/>
                                    <Border Grid.Column="2" Style="{StaticResource RiskBadge}">
                                        <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <Border Grid.Column="3"
                                            Style="{StaticResource AdminBadge}"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Admin" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding NoteCount, StringFormat='{}{0} notes'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding FileCount, StringFormat='{}{0:#,0} files'}"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <!-- Exact file that will be deleted -->
                            <DataTemplate DataType="{x:Type vm:FileReviewItem}">
                                <Grid Margin="2,1" MinHeight="22" ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeBytes, Converter={StaticResource BytesToDisplay}}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>

                            <!-- Cap indicator for very large rules -->
                            <DataTemplate DataType="{x:Type vm:MoreFilesItem}">
                                <TextBlock Text="{Binding Count, StringFormat='… and {0:#,0} more files (not listed)'}"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="2,3"/>
                            </DataTemplate>

                            <!-- Scan-time note (e.g. a skipped path and why) -->
                            <DataTemplate DataType="{x:Type vm:RuleNoteItem}">
                                <TextBlock Text="{Binding Text}"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="2,3"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Rescan"
                            Command="{Binding ScanCommand}"
                            MinWidth="110"/>
                    <Button Content="Clean selected…"
                            Command="{Binding CleanSelectedCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="150"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- SUMMARY -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Summary">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Headline numbers -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="10"
                            Padding="18,14"
                            Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="SPACE FREED"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource RiskSafeBrush}"
                                       Margin="0,4,0,0"
                                       Text="{Binding LastCleanResult.TotalBytesFreed, Converter={StaticResource BytesToDisplay}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="10"
                            Padding="18,14"
                            Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="FILES REMOVED"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock FontSize="21"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Text="{Binding LastCleanResult.TotalFilesRemoved, StringFormat='{}{0:#,0}'}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="10"
                            Padding="18,14"
                            Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="FILES SKIPPED"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource RiskModerateBrush}"
                                       Margin="0,4,0,0"
                                       Text="{Binding LastCleanResult.TotalFilesSkipped, StringFormat='{}{0:#,0}'}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Details -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="14,10"
                        MinHeight="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Skipped files and why"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="4,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastCleanResult.TotalFilesSkipped}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LastCleanResult.SkippedOutcomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"
                                                           MaxWidth="480"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Reason}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding LastCleanResult.Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,6,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rule.Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BytesFreed, Converter={StaticResource BytesToDisplay}}"
                                                           Foreground="{DynamicResource RiskSafeBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FilesRemoved, StringFormat='{}{0:#,0} removed'}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding FilesSkipped, StringFormat='{}{0} skipped'}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Done"
                            Command="{Binding CloseSummaryCommand}"
                            MinWidth="110"/>
                    <Button Content="Scan again"
                            Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="130"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
