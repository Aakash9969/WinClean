<Window x:Class="WinClean.App.Views.ConfirmCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinClean.App.Converters"
        Title="Confirm clean"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BaseBackground}">
    <Window.Resources>
        <conv:BytesToDisplayConverter x:Key="BytesToDisplay"/>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <!-- Heading -->
        <StackPanel DockPanel.Dock="Top">
            <Path Data="M12 2 L22.5 20 L1.5 20 Z M12 8.5 L12 14.5 M12 16.8 L12 17.2"
                  Fill="{DynamicResource RiskAdvancedBrush}"
                  Stroke="{DynamicResource RiskAdvancedBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="28" Height="28"
                  Stretch="Uniform"
                  HorizontalAlignment="Left"/>
            <TextBlock Text="Permanently delete these files?"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,12,0,6"/>
            <TextBlock Text="{Binding HeadingText}"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Bottom">
            <Border Background="{DynamicResource RiskAdvancedBackground}"
                    BorderBrush="{DynamicResource RiskAdvancedBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,16,0,0">
                <TextBlock Text="Files are deleted permanently — they are not moved to the Recycle Bin. Anything locked, protected or in use is skipped automatically and listed with the reason."
                           Foreground="{DynamicResource RiskAdvancedBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"/>
                <Button Content="Clean now"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="120"
                        Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Rule list -->
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="10"
                Padding="12"
                Margin="0,14,0,0">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Confirmation.Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RuleName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Border Grid.Column="1" Style="{StaticResource RiskBadge}">
                                    <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BadgeText}"/>
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding FileCount, StringFormat='{}{0:#,0} files'}"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
