<UserControl x:Class="WinClean.App.Views.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinClean.App.Converters">
    <UserControl.Resources>
        <conv:BytesToDisplayConverter x:Key="BytesToDisplay"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Memory"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       MaxWidth="520"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820"
                        HorizontalAlignment="Left"
                        Margin="0,0,16,0">

                <!-- Usage -->
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           Text="{Binding TotalBytes, Converter={StaticResource BytesToDisplay}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IN USE"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource RiskModerateBrush}"
                                           Text="{Binding UsedBytes, Converter={StaticResource BytesToDisplay}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AVAILABLE"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource RiskSafeBrush}"
                                           Text="{Binding AvailableBytes, Converter={StaticResource BytesToDisplay}}"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UsedPercent}"
                                     Margin="0,16,0,6"/>
                        <TextBlock Text="{Binding UsedPercent, StringFormat='{}{0:0}% of physical memory in use'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Optimize -->
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Optimize memory"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Trims the working sets of running applications so Windows reclaims physical RAM — the standard memory-cleaner technique. Applications fault their pages back on demand, so nothing breaks and nothing is terminated. Critical system processes are never touched, and anything that needs more rights is skipped and listed below."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Optimize memory"
                                    Command="{Binding OptimizeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="160"/>
                            <Button Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    MinWidth="100"
                                    Margin="12,0,0,0"/>
                            <Button Content="Restart elevated"
                                    Command="{Binding RestartElevatedCommand}"
                                    MinWidth="130"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Restarting elevated lets WinClean also trim system and other users' processes."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10"
                        Padding="18,14"
                        Visibility="{Binding HasOptimized, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RAM FREED"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RiskSafeBrush}"
                                           Margin="0,4,0,0"
                                           Text="{Binding LastResult.BytesFreed, Converter={StaticResource BytesToDisplay}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PROCESSES TRIMMED"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="21"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           Text="{Binding LastResult.TrimmedCount}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SKIPPED"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource RiskModerateBrush}"
                                           Margin="0,4,0,0"
                                           Text="{Binding LastResult.SkippedCount}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="Skipped processes and why"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastResult.Skipped.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LastResult.Skipped}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProcessName, StringFormat='{}{0}'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SkipReason}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
