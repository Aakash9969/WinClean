<UserControl x:Class="WinClean.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinClean.App.Converters">
    <UserControl.Resources>
        <conv:BytesToDisplayConverter x:Key="BytesToDisplay"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="History"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    MinWidth="100"/>
        </Grid>

        <!-- Empty state -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,28"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="No cleans yet"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Every clean you run is recorded here — space freed, files removed, and anything skipped with its reason."
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="340"/>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,10">
                            <Grid ToolTip="{Binding RulesToolTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding WhenText}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding SkippedNote}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TotalBytesFreed, Converter={StaticResource BytesToDisplay}}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource RiskSafeBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TotalFilesRemoved, StringFormat='{}{0:#,0} files removed'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
