<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: same keys as the dark palette, so the Controls dictionary never changes -->
    <SolidColorBrush x:Key="BaseBackground" Color="#F4F5F9"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#E9EBF1"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#E1E5EE"/>
    <SolidColorBrush x:Key="PressedBackground" Color="#C9CEDC"/>
    <SolidColorBrush x:Key="BorderColor" Color="#C4CAD8"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2335"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#49505F"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7A8194"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B7DD8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5590E3"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C67C4"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RiskSafeBrush" Color="#1F8A3B"/>
    <SolidColorBrush x:Key="RiskModerateBrush" Color="#9A6A00"/>
    <SolidColorBrush x:Key="RiskAdvancedBrush" Color="#C73550"/>
    <SolidColorBrush x:Key="RiskSafeBackground" Color="#1E1F8A3B"/>
    <SolidColorBrush x:Key="RiskModerateBackground" Color="#1E9A6A00"/>
    <SolidColorBrush x:Key="RiskAdvancedBackground" Color="#1EC73550"/>

</ResourceDictionary>
