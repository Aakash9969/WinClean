<Window x:Class="WinClean.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BaseBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,26">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 0.8 L14.5 9.5 L23.2 12 L14.5 14.5 L12 23.2 L9.5 14.5 L0.8 12 L9.5 9.5 Z"
                              Fill="{DynamicResource AccentBrush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="WinClean"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Scan first. Delete only what you approve."
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="28,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <Border Height="1"
                            Background="{DynamicResource BorderColor}"
                            Margin="0,0,0,12"/>
                    <Border Visibility="{Binding IsRunningElevated, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource RiskModerateBackground}"
                            CornerRadius="4"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8">
                        <TextBlock Text="Administrator"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RiskModerateBrush}"/>
                    </Border>
                    <TextBlock Text="Nothing is ever deleted without your explicit approval."
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Logs live in %LOCALAPPDATA%\WinClean\logs"
                               FontSize="10"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel VerticalAlignment="Top">
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="cleaner">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCleanerActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 0.8 L14.5 9.5 L23.2 12 L14.5 14.5 L12 23.2 L9.5 14.5 L0.8 12 L9.5 9.5 Z"
                                  Fill="{DynamicResource TextSecondary}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Cleaner" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="memory">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoryActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas>
                                    <Rectangle Canvas.Left="2" Canvas.Top="2.5" Width="12" Height="8"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                               Fill="Transparent"/>
                                    <Line X1="5" Y1="10.5" X2="5" Y2="14"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="8" Y1="10.5" X2="8" Y2="14"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="11" Y1="10.5" X2="11" Y2="14"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                            <TextBlock Text="Memory" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="history">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistoryActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2.8,12 A9.2,9.2 0 1 1 21.2,12 A9.2,9.2 0 1 1 2.8,12 M12,12 L12,6.8 M12,12 L15.6,14.4"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="History" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas>
                                    <Line X1="1" Y1="4" X2="15" Y2="4"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="1" Y1="8" X2="15" Y2="8"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="1" Y1="12" X2="15" Y2="12"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="2" Width="4" Height="4"
                                             Fill="{DynamicResource SidebarBackground}"
                                             Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="6" Width="4" Height="4"
                                             Fill="{DynamicResource SidebarBackground}"
                                             Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/>
                                    <Ellipse Canvas.Left="11" Canvas.Top="10" Width="4" Height="4"
                                             Fill="{DynamicResource SidebarBackground}"
                                             Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"/>
                                </Canvas>
                            </Grid>
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1"
                Padding="28,24,24,20">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </Grid>
</Window>
